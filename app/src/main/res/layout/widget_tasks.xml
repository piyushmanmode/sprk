<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_tasks_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_card"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Top Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:contentDescription="Checklist"
            android:src="@drawable/ic_check_circle" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="TODAY'S HABITS"
            android:textColor="#FF1E130D"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_tasks_progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_item_bg"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:text="2/3 Done"
            android:textColor="#FFFF5C1C"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Task Items List -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <!-- Task 1 -->
        <LinearLayout
            android:id="@+id/widget_task_row_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="3dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/widget_task_check_1"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:contentDescription="Status"
                android:src="@drawable/ic_check_circle" />

            <TextView
                android:id="@+id/widget_task_title_1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Read 20 pages habit book"
                android:textColor="#FF1E130D"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Task 2 -->
        <LinearLayout
            android:id="@+id/widget_task_row_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="3dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/widget_task_check_2"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:contentDescription="Status"
                android:src="@drawable/ic_circle_outline" />

            <TextView
                android:id="@+id/widget_task_title_2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Write UX design journal"
                android:textColor="#FF1E130D"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Task 3 -->
        <LinearLayout
            android:id="@+id/widget_task_row_3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="3dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/widget_task_check_3"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:contentDescription="Status"
                android:src="@drawable/ic_check_circle" />

            <TextView
                android:id="@+id/widget_task_title_3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="15 mins morning workout"
                android:textColor="#FF1E130D"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Footer -->
    <TextView
        android:id="@+id/widget_tasks_footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:text="Tap to check off habits →"
        android:textColor="#FFFF5C1C"
        android:textSize="11sp"
        android:textStyle="bold" />
</LinearLayout>
